# Per-worktree Docker Compose config (GH #59). Compose auto-reads `.env` from the
# directory it runs in. `scripts/dev-setup.sh` writes this file for a new
# worktree with a free pair of ports; edit by hand if you need to.
#
# The canonical checkout needs NO .env — the defaults below are what it uses.
# A second stack (a feature worktree, or ../hh-staging) needs its own values so
# it doesn't collide on ports / container names / volumes.

# Scopes every container, network and named volume. Default = directory name.
COMPOSE_PROJECT_NAME=hh-<topic>

# The app's host port: the screen, and the API under /api. Canonical: 8000.
# Staging: 8010. Feature worktrees: dev-setup.sh picks the next free one from 8011.
APP_PORT=8010

# Port bind address. Default 127.0.0.1 (loopback — the tailnet stack is reached
# via `tailscale serve`, and 0.0.0.0 would clash with tailscaled). Set 0.0.0.0 to
# expose a NON-tailnet stack on the LAN.
BIND_HOST=127.0.0.1

# Shared Parquet store. Point at the canonical checkout's data/ to read one
# store from every stack. Unset (or ./data) = this worktree's own data/.
HH_DATA_ROOT=../honest-healthcare/data

# A non-primary stack can run leaner.
DUCKDB_MEMORY_LIMIT=2GB

# A worktree that rebuilds the find-care tables can write them, and serve them,
# from its own folder instead of the shared store's (integration still reads the
# shared store's data/ingestion/):
#   HH_SERVING_DIR=./data-local/serving
