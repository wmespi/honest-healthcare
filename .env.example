# Per-worktree Docker Compose config (GH #59). Compose auto-reads `.env` from the
# directory it runs in. `scripts/dev-setup.sh` writes this file for a new
# worktree with a free port triplet; edit by hand if you need to.
#
# The canonical checkout needs NO .env — the defaults below are what it uses.
# A second stack (a feature worktree, or ../hh-staging) needs its own values so
# it doesn't collide on ports / container names / Postgres volume.

# Scopes every container, network and named volume. Default = directory name.
COMPOSE_PROJECT_NAME=hh-<topic>

# Host ports. Canonical: 5432 / 8000 / 5173. Staging: 5433 / 8010 / 5183.
# Feature worktrees: dev-setup.sh picks the next free triplet from 5434+ / 8020+ / 5193+.
DB_PORT=5433
API_PORT=8010
WEB_PORT=5183

# The frontend derives the API URL as <host>:8000 at runtime. Override whenever
# this stack's API_PORT isn't 8000.
VITE_API_URL=http://localhost:8010

# Shared Parquet store. Point at the canonical checkout's data/ to read one
# store from every stack. Unset (or ./data) = this worktree's own data/.
HH_DATA_ROOT=../honest-healthcare/data

# A non-primary stack can run leaner.
DUCKDB_MEMORY_LIMIT=2GB

# ── Sub-store split (GH #59 Part C) ────────────────────────────────────────────
# For a worktree that REBUILDS reference / CMS / summary parquet: read the big
# immutable stores from the shared corpus, write the rebuilt ones locally.
# `dev-setup.sh --rebuild-reference` sets these + seeds ./data-local from the
# shared store. Each defaults under DATA_DIR (= /app/data) when unset.
#   ANTHEM_DIR=/app/data/anthem          # from the shared HH_DATA_ROOT mount
#   NPPES_DIR=/app/data/nppes
#   REFERENCE_DIR=/app/data-local/reference
#   CMS_DIR=/app/data-local/cms
#   SUMMARY_DIR=/app/data-local/anthem/summary
